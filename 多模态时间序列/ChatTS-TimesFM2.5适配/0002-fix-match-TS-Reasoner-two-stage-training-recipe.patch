+    "columns": {
+      "prompt": "input",
+      "response": "output",
+      "timeseries": "timeseries"
+    }
+  }
+}
diff --git a/scripts/full/train_timesfm2_5_stage1.sh b/scripts/full/train_timesfm2_5_stage1.sh
index ff6ef4a..e972e22 100755
--- a/scripts/full/train_timesfm2_5_stage1.sh
+++ b/scripts/full/train_timesfm2_5_stage1.sh
@@ -1,6 +1,10 @@
 #!/usr/bin/env bash
 
-# Alignment stage: frozen TimesFM 2.5 + trainable TS-to-text projector + ChatTS LLM.
+# TS-Reasoner-style alignment stage.
+# Trainable: the complete ChatTS LLM and the TS-to-text projector.
+# Frozen: the complete TimesFM 2.5 backbone.
+# Paper recipe: 120K captions, global batch 64, lr 1e-5, one epoch.
+# With 8 GPUs: 1 sample/GPU * 8 accumulation steps * 8 GPUs = 64.
 # Install once with: pip install -e ".[timesfm,deepspeed]"
 
 NCCL_DEBUG=WARN DEEPSPEED_TIMEOUT=120 deepspeed --num_gpus 8 --master_port=19901 src/train.py \
@@ -9,23 +13,22 @@ NCCL_DEBUG=WARN DEEPSPEED_TIMEOUT=120 deepspeed --num_gpus 8 --master_port=19901
     --model_name_or_path "[PATH_TO_CHATTS_BASE_MODEL]" \
     --ts_encoder_type timesfm2_5 \
     --timesfm_model_name_or_path "google/timesfm-2.5-200m-pytorch" \
-    --dataset "align_256,ift" \
-    --interleave_probs "0.9,0.1" \
+    --dataset "stage_1_120K" \
+    --interleave_probs "1.0" \
     --do_train \
     --mix_strategy "interleave_over" \
     --template "chatts" \
     --finetuning_type full \
     --output_dir "[OUTPUT_PATH_TIMESFM_STAGE_1]" \
     --overwrite_output_dir \
-    --per_device_train_batch_size 2 \
-    --gradient_accumulation_steps 32 \
+    --per_device_train_batch_size 1 \
+    --gradient_accumulation_steps 8 \
     --lr_scheduler_type cosine \
     --logging_steps 1 \
     --save_steps 100 \
     --learning_rate 1e-5 \
-    --timeseries_sft_lr 1e-4 \
     --warmup_ratio 0.02 \
-    --max_steps 1000 \
+    --num_train_epochs 1 \
     --plot_loss \
     --bf16 \
     --save_only_model \
diff --git a/scripts/full/train_timesfm2_5_stage2.sh b/scripts/full/train_timesfm2_5_stage2.sh
index 758e6e5..9393a34 100755
--- a/scripts/full/train_timesfm2_5_stage2.sh
+++ b/scripts/full/train_timesfm2_5_stage2.sh
@@ -1,30 +1,32 @@
 #!/usr/bin/env bash
 
-# Instruction stage. `auto` reads `timesfm2_5` from the stage-1 config and
-# restores the saved projector while reloading the frozen Google checkpoint.
+# TS-Reasoner-style instruction stage. `auto` reads `timesfm2_5` from the
+# stage-1 config and restores the trainable projector while reloading the
+# frozen Google checkpoint. The complete ChatTS LLM remains trainable.
+# Paper recipe: 30K instructions, global batch 32, lr 2e-5, two epochs.
+# With 8 GPUs: 1 sample/GPU * 4 accumulation steps * 8 GPUs = 32.
 
 NCCL_DEBUG=WARN DEEPSPEED_TIMEOUT=120 deepspeed --num_gpus 8 --master_port=19901 src/train.py \
     --deepspeed ds_config/ds_config_3.json \
     --stage sft \
     --model_name_or_path "[OUTPUT_PATH_TIMESFM_STAGE_1]" \
     --ts_encoder_type auto \
-    --dataset "sft,ift,align_random" \
-    --interleave_probs "0.6,0.2,0.2" \
+    --dataset "stage_2_30K" \
+    --interleave_probs "1.0" \
     --do_train \
     --mix_strategy "interleave_over" \
     --template "chatts" \
     --finetuning_type full \
     --output_dir "[OUTPUT_PATH_TIMESFM_STAGE_2]" \
     --overwrite_output_dir \
-    --per_device_train_batch_size 2 \
-    --gradient_accumulation_steps 32 \
+    --per_device_train_batch_size 1 \
+    --gradient_accumulation_steps 4 \
     --lr_scheduler_type cosine \
     --logging_steps 1 \
     --save_steps 100 \
-    --learning_rate 1e-5 \
-    --timeseries_sft_lr 3e-5 \
+    --learning_rate 2e-5 \
     --warmup_ratio 0.02 \
-    --max_steps 400 \
+    --num_train_epochs 2 \
     --plot_loss \
     --bf16 \
     --save_only_model \
